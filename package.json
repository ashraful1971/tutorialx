{
  "name": "tutorialx-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false && tsc --project tsconfig.tests.json",
    "clean": "tsc --build --clean",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "boundaries": "depcruise packages/*/src --config .dependency-cruiser.cjs --output-type err-long",
    "test": "vitest run",
    "package:audit": "node scripts/package-audit.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test && pnpm package:audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

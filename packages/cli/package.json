{
  "name": "@tutorialx/cli",
  "version": "0.1.0",
  "description": "TutorialX command, MCP, and worker composition roots",
  "type": "module",
  "bin": {
    "tutorialx": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/skills/tutorialx/**/*.md",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@tutorialx/contracts": "workspace:^",
    "@tutorialx/core": "workspace:^",
    "@tutorialx/adapters": "workspace:^"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/skill-reference.mjs --bundle",
    "typecheck": "tsc --build --pretty false"
  }
}
